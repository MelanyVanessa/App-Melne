<?xml version="1.0" encoding="utf-8"?>
<!-- Manrope (SIL Open Font License): tipografía de texto de la app -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute">
    <font
        android:font="@font/manrope_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/manrope_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/manrope_semibold"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/manrope_semibold"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/manrope_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/manrope_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
