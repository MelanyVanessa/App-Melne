<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:cardBackgroundColor="@color/melne_surface_variant"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/imgProducto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_producto" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/datosProducto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:focusable="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMarca"
            style="@style/Melne.Sobretitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Dior" />

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/manrope_semibold"
            android:maxLines="2"
            android:textColor="@color/melne_primary"
            android:textSize="16sp"
            app:fontFamily="@font/manrope_semibold"
            tools:text="Sauvage" />

        <TextView
            android:id="@+id/tvPrecio"
            style="@style/Melne.Precio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            tools:text="$160.000 COP" />

        <!-- Estado de stock: ícono + texto (no depende solo del color) -->
        <TextView
            android:id="@+id/tvStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:textSize="12sp"
            tools:drawableStart="@drawable/ic_check_circle"
            tools:text="Stock: 12  •  Activo"
            tools:textColor="@color/status_delivered_text" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnEditar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_edit"
        app:tint="@color/melne_primary"
        android:contentDescription="@string/editar" />

    <ImageButton
        android:id="@+id/btnEliminar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_delete"
        app:tint="@color/melne_error"
        android:contentDescription="@string/eliminar" />
</LinearLayout>
