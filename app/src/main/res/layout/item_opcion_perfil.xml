<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de opción del perfil: ícono en círculo, título, detalle y flecha -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/icono"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circulo_tonal"
        android:importantForAccessibility="no"
        android:padding="8dp"
        app:tint="@color/melne_primary"
        tools:src="@drawable/ic_phone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_semibold"
            app:fontFamily="@font/manrope_semibold"
            android:textColor="@color/melne_primary"
            android:textSize="16sp"
            tools:text="Contactar por WhatsApp" />

        <TextView
            android:id="@+id/detalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/melne_text_secondary"
            android:textSize="14sp"
            tools:text="+57 300 123 4567" />
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/melne_text_secondary" />
</LinearLayout>
